# Quadlet unit: alternative to compose + podman-restart.service (docs/BOOT.md).
# Use EITHER this OR `make up`, never both: both create a container named "hermes".
#
# Install (as your normal user, not root):
#   mkdir -p ~/.config/containers/systemd
#   cp deploy/hermes.container ~/.config/containers/systemd/
#   systemctl --user daemon-reload
#   systemctl --user start hermes.service
# Paths below assume BASE_DIR=/srv/hermes-podman; edit them if yours differs.
# Keep Image= identical to compose.yaml (scripts/upgrade.sh only edits compose.yaml).

[Unit]
Description=Hermes Agent gateway (rootless Podman, headless)
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/nousresearch/hermes-agent:v0.22.5@sha256:9c5561579f3ffdf333401797094ac3a743738d6c25d40f4331c7bf77b694238d
ContainerName=hermes
Exec=gateway run
UserNS=keep-id:uid=10000,gid=10000
User=0
Group=0
EnvironmentFile=/srv/hermes-podman/.env
Volume=/srv/hermes-podman/data:/opt/data
# No PublishPort=, no Entrypoint override, no --init: s6-overlay is PID 1.

[Service]
Restart=always
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=default.target
