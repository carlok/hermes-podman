# Container environment for the hermes service (compose.yaml: env_file).
# Copy to .env (make setup does this) and edit. .env is gitignored.
#
# API keys normally do NOT go here: the setup wizard (make setup) writes them
# to data/.env, which Hermes reads from /opt/data/.env. Put a key here only if
# you want it to override data/.env.

# Time zone used for logs and cron jobs inside the container.
TZ=Etc/UTC

# Optional. File mode Hermes applies to its home directory (/opt/data),
# e.g. 0700. Unset = image default.
# HERMES_HOME_MODE=0700

# Optional. Set to 1 to skip the automatic config.yaml schema migration that
# runs on start after an upgrade (it writes a timestamped backup first).
# HERMES_SKIP_CONFIG_MIGRATION=

# Do NOT set these in this deployment (see docs/DECISIONS.md):
#   HERMES_DASHBOARD          - would start the web dashboard
#   HERMES_GATEWAY_NO_SUPERVISE - would disable s6 supervision of the gateway
#   HERMES_UID / HERMES_GID / PUID / PGID - UID mapping is done by Podman
#                               (userns_mode keep-id), not by the image
